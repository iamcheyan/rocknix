#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Kill any process currently bound to TCP port 5555 so a fresh adbd can bind.
# Skips when USB ADB gadget mode is active (usbgadget owns adbd there).
[ "$(usbgadget 2>/dev/null)" = "adb" ] && exit 0
for pid in $(netstat -lntp 2>/dev/null | awk '/:5555 / { n=split($7,a,"/"); if (n>0 && a[1] ~ /^[0-9]+$/) print a[1] }'); do
  kill "$pid" 2>/dev/null
done
