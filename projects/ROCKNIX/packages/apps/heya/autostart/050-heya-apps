#!/bin/sh
# Seed heya's writable app directory from the read-only image copies.
#
source_root=${HEYA_SYSTEM_APPS:-/usr/share/heya/apps}
target_root=${HEYA_USER_APPS:-/storage/heya/apps}
state_root=${HEYA_APP_STATE:-/storage/heya/.system-apps}
legacy_root=${HEYA_LEGACY_APPS:-/usr/share/heya/legacy-apps}
removed=${HEYA_REMOVED_APPS:-/usr/share/heya/removed-apps}

[ -d "${source_root}" ] || exit 0
mkdir -p "${target_root}" "${state_root}"

if [ -f "${removed}" ]; then
  while read -r app_id; do
    [ -n "${app_id}" ] || continue
    case "${app_id}" in \#*) continue ;; esac
    [ -f "${source_root}/${app_id}/app.json" ] && continue
    rm -rf "${target_root:?}/${app_id}"
  done < "${removed}"
fi

for manifest in "${source_root}"/*/app.json; do
  [ -f "${manifest}" ] || continue

  app_dir=${manifest%/app.json}
  app_id=${app_dir##*/}
  target="${target_root}/${app_id}/app.json"
  previous="${state_root}/${app_id}.json"
  legacy="${legacy_root}/${app_id}.json"
  available=yes
  if [ -f "${app_dir}/requires" ]; then
    while IFS= read -r program; do
      [ -n "${program}" ] || continue
      if ! command -v "${program}" >/dev/null 2>&1; then
        available=no
        break
      fi
    done < "${app_dir}/requires"
  fi
  if [ "${available}" = no ]; then
    if [ -f "${previous}" ] && cmp -s "${previous}" "${target}"; then
      rm -f "${target}"
    fi
    continue
  fi
  if [ ! -e "${target}" ] || cmp -s "${previous}" "${target}" || cmp -s "${legacy}" "${target}"; then
    mkdir -p "${target_root}/${app_id}"
    cp "${manifest}" "${target}.new"
    mv "${target}.new" "${target}"
  fi
  cp "${manifest}" "${previous}.new"
  mv "${previous}.new" "${previous}"
done

if [ -f /usr/share/heya/themes/default/theme.json ] && [ ! -f /storage/heya/themes/theme.json ]; then
  mkdir -p /storage/heya/themes
  cp /usr/share/heya/themes/default/theme.json /storage/heya/themes/theme.json
fi

exit 0
