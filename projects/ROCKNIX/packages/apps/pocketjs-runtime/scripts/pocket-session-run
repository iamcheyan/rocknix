#!/bin/bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "Usage: pocket-session-run COMMAND [ARG...]" >&2
  exit 2
fi

mkdir -p /run/lock
exec 9>/run/lock/pocketjs-display.lock
flock -n 9 || { echo "Another foreground application owns the display" >&2; exit 1; }

resume=0
systemctl is-active --quiet pocketjs-kms.service && resume=1
recovery=0
systemctl is-active --quiet pocketjs-recovery.service && recovery=1
runner_pid=
cleanup() {
  status=$?
  trap - EXIT
  systemctl stop pocketjs-foreground.service || true
  if [ -n "$runner_pid" ]; then
    kill "$runner_pid" 2>/dev/null || true
    wait "$runner_pid" 2>/dev/null || true
  fi
  if [ "$resume" = 1 ]; then
    systemctl start pocketjs-kms.service || true
  elif [ "$recovery" = 1 ]; then
    systemctl start pocketjs-recovery.service || true
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' HUP TERM

systemctl stop pocketjs-kms.service
systemd-run --unit=pocketjs-foreground --wait --collect --service-type=exec \
  --property=TTYPath=/dev/tty7 --property=StandardInput=tty --property=TTYReset=yes \
  --property='ExecStartPre=/usr/bin/chvt 7' --property=Conflicts=pocketjs-recovery.service \
  --property=KillMode=control-group --property=TimeoutStopSec=5 \
  --property='UnsetEnvironment=WAYLAND_DISPLAY DISPLAY' \
  --setenv=HOME=/storage --setenv=SDL_VIDEODRIVER=kmsdrm --setenv=SDL_AUDIODRIVER=pulseaudio \
  --setenv=LOVE_GRAPHICS_USE_OPENGLES=1 \
  --setenv=XDG_RUNTIME_DIR=/run/0-runtime-dir \
  --setenv=SDL_GAMECONTROLLERCONFIG_FILE=/usr/config/SDL-GameControllerDB/gamecontrollerdb.txt \
  -- "$@" &
runner_pid=$!
status=0
wait "$runner_pid" || status=$?
runner_pid=
exit "$status"
