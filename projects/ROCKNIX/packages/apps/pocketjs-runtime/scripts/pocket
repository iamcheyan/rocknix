#!/bin/sh
set -eu
mkdir -p /storage/pocketjs/apps /storage/pocketjs/data /storage/pocketjs/cache /storage/pocketjs/logs
app=${POCKETJS_APP:-/usr/share/pocketjs/apps/boot.pocket}
if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
  app=$1
  shift
fi
exec /usr/libexec/pocket-linux-kms --package "$app" "$@"
