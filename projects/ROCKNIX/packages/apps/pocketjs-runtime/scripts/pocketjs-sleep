#!/usr/bin/env python3
"""PocketJS screen auto-sleep daemon.

Listens to /dev/input/event* and dims the backlight to 0 after a period of
no input. Restores the previous brightness on the next input event.

Config: /storage/.config/pocketjs/runtime.conf
  sleep.timeout = never | 10s | 30s | 1m | 5m | 15m | 30m | 1h

The daemon must run as root to read /dev/input and write /sys/class/backlight.
"""
import os
import sys
import time
import select

BACKLIGHT_DIR = "/sys/class/backlight"
CONFIG_PATH = "/storage/.config/pocketjs/runtime.conf"
STATE_PATH = "/storage/.config/pocketjs/sleep-state"

TIMEOUTS = {
    "never": None,
    "10s": 10,
    "30s": 30,
    "1m": 60,
    "5m": 300,
    "15m": 900,
    "30m": 1800,
    "1h": 3600,
}


def read_brightness():
    for entry in os.listdir(BACKLIGHT_DIR):
        path = os.path.join(BACKLIGHT_DIR, entry)
        try:
            cur = int(open(os.path.join(path, "brightness")).read().strip())
            mx = int(open(os.path.join(path, "max_brightness")).read().strip())
            if mx > 0:
                return path, cur, mx
        except (OSError, ValueError):
            continue
    return None, None, None


def set_brightness(path, value):
    if not path:
        return False
    try:
        open(os.path.join(path, "brightness"), "w").write(str(value))
        return True
    except OSError:
        return False


def load_config():
    # runtime.conf may be a plain KEY=VALUE file; only honour an explicit
    # [sleep] timeout section and ignore everything else.
    raw = "30m"
    try:
        in_section = False
        with open(CONFIG_PATH) as f:
            for line in f:
                s = line.strip()
                if s.startswith("[") and s.endswith("]"):
                    in_section = (s == "[sleep]")
                    continue
                if in_section and s.startswith("timeout") and "=" in s:
                    raw = s.split("=", 1)[1].strip()
    except OSError:
        pass
    return TIMEOUTS.get(raw, 1800)


def load_saved_brightness():
    try:
        return int(open(STATE_PATH).read().strip())
    except (OSError, ValueError):
        return None


def save_brightness(value):
    try:
        os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
        open(STATE_PATH, "w").write(str(value))
    except OSError:
        pass


def find_input_devices():
    devices = []
    for name in sorted(os.listdir("/dev/input")):
        if name.startswith("event") and os.path.exists(os.path.join("/dev/input", name)):
            devices.append(os.path.join("/dev/input", name))
    return devices


def main():
    timeout = load_config()
    bl_path, cur, mx = read_brightness()
    if not bl_path:
        print("pocketjs-sleep: no backlight device found", file=sys.stderr)
        sys.exit(1)

    saved = load_saved_brightness()
    if saved is not None and saved > 0:
        # Restore the brightness remembered from a previous session.
        if saved != cur:
            set_brightness(bl_path, saved)
        cur = saved
    else:
        # No valid saved state (missing, or 0 = "was dimmed"): never start dark.
        if cur == 0:
            cur = mx
            set_brightness(bl_path, cur)
        save_brightness(cur)

    devices = find_input_devices()
    if not devices:
        print("pocketjs-sleep: no /dev/input/event* devices", file=sys.stderr)
        sys.exit(1)

    fds = {}
    for dev in devices:
        try:
            fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
            fds[fd] = dev
        except OSError:
            pass
    if not fds:
        print("pocketjs-sleep: cannot open any input device", file=sys.stderr)
        sys.exit(1)

    timeout_label = "never" if timeout is None else f"{timeout}s"
    print(f"pocketjs-sleep: timeout={timeout_label} backlight={bl_path} cur={cur} max={mx} devices={list(fds.values())}", flush=True)
    last_input = time.monotonic()
    dimmed = False

    while True:
        remaining = None if timeout is None else max(0.0, timeout - (time.monotonic() - last_input))
        if timeout is not None and remaining == 0 and not dimmed:
            set_brightness(bl_path, 0)
            dimmed = True
            print("pocketjs-sleep: screen dimmed", flush=True)
        poll = None if (timeout is None or dimmed) else max(0.05, min(1.0, remaining))
        r, _, _ = select.select(list(fds), [], [], poll)
        if r:
            for fd in r:
                try:
                    os.read(fd, 64)
                except OSError:
                    pass
            last_input = time.monotonic()
            if dimmed:
                if set_brightness(bl_path, cur):
                    dimmed = False
                    print("pocketjs-sleep: screen restored", flush=True)


if __name__ == "__main__":
    main()