[Unit]
Description=ROCKNIX PocketJS direct KMS interface
After=local-fs.target systemd-user-sessions.service
Conflicts=pocketjs-recovery.service
Before=graphical.target
OnFailure=pocketjs-recovery.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=HOME=/storage
EnvironmentFile=-/storage/.config/pocketjs/runtime.conf
TTYPath=/dev/tty7
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
ExecStartPre=/usr/bin/chvt 7
ExecStart=/usr/libexec/pocketjs-session
Restart=always
RestartSec=3
TimeoutStopSec=5
KillMode=control-group

[Install]
WantedBy=rocknix.target
