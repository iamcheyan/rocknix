. /etc/profile.d/001-functions

MIGRATED="/storage/.config/.h700_sleep_migrated"
OVERRIDE="/storage/.config/logind.conf.d/login.conf"

# undo the old quirk's "suspendmode off" and power-key override, once
if [ ! -e "${MIGRATED}" ]
then
  grep -qs '^HandlePowerKey=ignore' "${OVERRIDE}" && rm -f "${OVERRIDE}"
  [ "$(get_setting system.suspendmode)" = "off" ] && del_setting system.suspendmode
  touch "${MIGRATED}"
fi

# this sets systemd's SuspendState; whether that resolves to s2idle
# or deep is the kernel's choice, made from what firmware offers
MYSLEEPMODE=$(get_setting system.suspendmode)
if [ -z "${MYSLEEPMODE}" ]
then
  /usr/bin/suspendmode mem
fi

# logind ignores the power key; rocknix-power-key suspends, or only blanks the
# screen while a player holds /run/media.pid
POWER_KEY_CONF="/storage/.config/logind.conf.d/power-key.conf"
if [ ! -e "${POWER_KEY_CONF}" ]
then
  mkdir -p "$(dirname "${POWER_KEY_CONF}")"
  printf '[Login]\nHandlePowerKey=ignore\n' > "${POWER_KEY_CONF}"
  systemctl restart systemd-logind
fi
